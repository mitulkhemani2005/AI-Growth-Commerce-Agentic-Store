# ============================================================
# AgentsOffice Environment Configuration
# ============================================================

# ---------- Database ----------
# Option A: SQLite (zero-setup, default)
DATABASE_URL_SYNC=sqlite:///./agents_office_data.db

# Option B: PostgreSQL (production)
# DATABASE_URL_SYNC=postgresql://agents_dev:agents_dev_pass@localhost:5432/agents_office

# ---------- Local Ollama Configuration (Default) ----------
OLLAMA_API_BASE=http://127.0.0.1:11434
DEFAULT_LLM_MODEL=ollama/qwen2.5:7b

# ---------- Cloud LLM API Keys (Optional - not needed if using Ollama) ----------
# Google Gemini
GEMINI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI ChatGPT
OPENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# DashScope / Qwen Cloud
DASHSCOPE_API_KEY=
