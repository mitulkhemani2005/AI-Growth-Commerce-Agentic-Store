# =====================================================================
# AI GROWTH COMMERCE AGENTIC STORE - Environment Configuration Template
# =====================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to version control!
# =====================================================================

# 1. LOCAL OLLAMA CONFIGURATION
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e2b-it-qat

# 2. AGENT SPECIFIC MODEL CONFIGURATIONS
CUSTOMER_MODEL=gemma4:e2b-it-qat
ADMIN_MODEL=gemma4:e2b-it-qat
PRICE_MANAGER_MODEL=gemma4:e2b-it-qat
INVENTORY_MANAGER_MODEL=gemma4:e2b-it-qat
ORDER_MANAGER_MODEL=gemma4:e2b-it-qat
FINANCE_MANAGER_MODEL=gemma4:e2b-it-qat
REVIEW_MANAGER_MODEL=gemma4:e2b-it-qat
CEO_MODEL=gemma4:e2b-it-qat

# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# Get your keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 4. 24/7 ADMIN AI AGENT SCHEDULE INTERVALS (in seconds)
# All agents run async and together every 1 second
DISPATCHER_INTERVAL_SECONDS=1
INVENTORY_AGENT_INTERVAL_SECONDS=1
FINANCE_AGENT_INTERVAL_SECONDS=1
PRICE_AGENT_INTERVAL_SECONDS=1
ORDER_AGENT_INTERVAL_SECONDS=1
REVIEW_AGENT_INTERVAL_SECONDS=1
CEO_AGENT_INTERVAL_SECONDS=1
