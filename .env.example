# =====================================================================
# NOVA - Environment Configuration Template
# =====================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to version control!
# =====================================================================

# 1. LOCAL OLLAMA CONFIGURATION
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:0.5b
# One configured local model, one concurrent inference request.  The app verifies /api/ps reports
# 100% VRAM residency at startup and refuses CPU/RAM model fallback.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=32
OLLAMA_ALLOW_MODEL_FALLBACK=false
AGENT_TASK_STALE_SECONDS=300
AGENT_CYCLE_TIMEOUT_SECONDS=180

# 2. AGENT SPECIFIC MODEL CONFIGURATIONS
CUSTOMER_MODEL=qwen2.5:0.5b
ADMIN_MODEL=qwen2.5:0.5b
PRICE_MANAGER_MODEL=qwen2.5:0.5b
INVENTORY_MANAGER_MODEL=qwen2.5:0.5b
ORDER_MANAGER_MODEL=qwen2.5:0.5b
FINANCE_MANAGER_MODEL=qwen2.5:0.5b
REVIEW_MANAGER_MODEL=qwen2.5:0.5b
CEO_MODEL=qwen2.5:0.5b

# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# Get your keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 4. 24/7 ADMIN AI AGENT SCHEDULE INTERVALS (in seconds)
# Organic background cycles with autonomous randomized timing
DISPATCHER_INTERVAL_SECONDS=15
INVENTORY_AGENT_INTERVAL_SECONDS=20
FINANCE_AGENT_INTERVAL_SECONDS=30
PRICE_AGENT_INTERVAL_SECONDS=20
ORDER_AGENT_INTERVAL_SECONDS=20
REVIEW_AGENT_INTERVAL_SECONDS=35
CEO_AGENT_INTERVAL_SECONDS=25

# =====================================================================
# 6. CEO TREASURY & 5 AI AUTONOMOUS BUYERS CONFIGURATION
# =====================================================================
# Starting Store / CEO Bank Balance in INR (default: 1000.0)
CEO_BANK_BALANCE=1000.0

# 5 AI Autonomous Shopper Agents (Staggered purchasing randomly within 5 minutes)
BUYER_MIN_INTERVAL_SECONDS=30
BUYER_MAX_INTERVAL_SECONDS=300
BUYER_SIMULATION_ENABLED=true

# NOVA RUNTIME
# Autonomous local GPU agents are enabled. Demo payments charge no money.
HOST=127.0.0.1
PORT=8000
PAYMENT_MODE=demo
AI_ENABLED=true
BACKGROUND_AGENTS_ENABLED=true
# Optional: protect Owner Studio APIs. Enter the same value in the owner login form.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOVA_ADMIN_TOKEN=
# Optional: store JSON files outside the repository. Seed inventory.json first.
# NOVA_DATA_DIR=D:/NovaData
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional extra embedding model; disabled to avoid downloads and CPU model loading.
SEMANTIC_EMBEDDINGS_ENABLED=false
FRONTEND_URL=http://127.0.0.1:5173
OLLAMA_NUM_CTX=4096
