# =====================================================================
# AI GROWTH COMMERCE AGENTIC STORE - Environment Configuration Template
# =====================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to version control!
# =====================================================================

# 1. CUSTOMER AI AGENT - GROQ API CONFIGURATION
CUSTOMER_GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_CUSTOMER_MODEL=qwen/qwen3.6-27b

# 2. ADMIN AI AGENT FLEET - GROQ CONFIGURATION
ADMIN_GROQ_API_KEY=your_admin_groq_api_key_here
GROQ_ADMIN_MODEL=qwen/qwen3.6-27b

# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# Get your keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 4. 24/7 ADMIN AI AGENT SCHEDULE INTERVALS (in seconds)
# Dispatcher Agent: fires every 2 minutes (120s)
DISPATCHER_INTERVAL_SECONDS=120
# Inventory Restock Manager: fires every 5 minutes (300s)
INVENTORY_AGENT_INTERVAL_SECONDS=300
# Refund Policy Manager: fires every 1 hour (3600s)
REFUND_AGENT_INTERVAL_SECONDS=3600
# Dynamic Price Optimizer: fires every 2 minutes (120s)
PRICE_AGENT_INTERVAL_SECONDS=120
# Order Lifecycle Manager: fires every 30 minutes (1800s)
ORDER_AGENT_INTERVAL_SECONDS=1800
# Customer Review & Sentiment Analyzer: fires every 2 hours (7200s)
REVIEW_AGENT_INTERVAL_SECONDS=7200
