# =====================================================================
# AI GROWTH COMMERCE AGENTIC STORE - .gitignore
# =====================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
!frontend/dist/
build/

eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.manifest
*.spec

# ---- Virtual Environments ----
.venv/
venv/
env/
ENV/
.env.bak
.Python

# ---- Environment / Secrets (CRITICAL - never commit real keys) ----
.env
.env.local
.env.production
.env.staging
*.key
*.pem
*.p12
secrets.json


# ---- IDE / Editor ----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# ---- Pytest / Testing ----
.pytest_cache/
htmlcov/
.coverage
*.cover
coverage.xml
nosetests.xml
test-results/

# ---- Logs ----
*.log
logs/

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ---- Node (if any tooling added later) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- AgentsOffice ----
agents_office_tmp/
agents_office_data.db
agents_office/.env
agents_office/frontend/node_modules/
agents_office/frontend/dist/

# ---- Temporary Scratch ----
scratch/
