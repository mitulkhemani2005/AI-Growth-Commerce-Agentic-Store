{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/backend.js": { "maxDuration": 120 }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/backend?__nova_path=api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/api/backend?__nova_path=static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
