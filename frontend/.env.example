# Same-origin API requests work with the bundled server and Vite proxy.
# Set only when the backend is intentionally hosted at another origin.
VITE_API_BASE_URL=
# Vercel uses the same-origin API function. Set NOVA_BACKEND_URL in Vercel
# to your public backend origin (server-only); VITE_API_BASE_URL is also
# accepted as a legacy server-side fallback. Do not include /api.
# Target used by npm run dev / npm run preview (server-side only).
NOVA_API_TARGET=http://127.0.0.1:8000
